---
import { formatDate, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  date?: string;
  location?: string;
  class?: string;
}

const { locale, date, location, class: className } = Astro.props;
---

<p class:list={['stamp', className]}>
  {location && <span>{location}</span>}
  {date && <time datetime={date}>{formatDate(locale, date)}</time>}
</p>
