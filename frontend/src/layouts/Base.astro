---
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';

import { LOCALE_NAMES, LOCALE_TAGS, LOCALES, localePath, t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** The URL of this page in each language; defaults to `section` in each. */
  alternates?: Partial<Record<Locale, string>>;
  section?: string;
  /** The page's main section, to highlight in the navigation. */
  active?: 'articles' | 'gallery' | 'team';
}

const { locale, title, description, alternates, section = '/', active } = Astro.props;

const siteName = t(locale, 'site.name');
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const pageDescription = description ?? t(locale, 'site.tagline');
const urls: Partial<Record<Locale, string>> =
  alternates ?? Object.fromEntries(LOCALES.map((code) => [code, localePath(code, section)]));

const navigation = [
  { key: 'articles', href: '/articles', label: t(locale, 'nav.articles') },
  { key: 'gallery', href: '/gallery', label: t(locale, 'nav.gallery') },
  { key: 'team', href: '/team', label: t(locale, 'nav.team') },
] as const;
---

<!doctype html>
<html lang={LOCALE_TAGS[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={localePath(locale, '/rss.xml')} />
    {
      LOCALES.filter((code) => urls[code]).map((code) => (
        <link rel="alternate" hreflang={LOCALE_TAGS[code]} href={new URL(urls[code]!, Astro.site)} />
      ))
    }
    <script is:inline>
      // Runs before the first paint, and again on each client-side navigation.
      const applyTheme = () => {
        let stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch {}
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      };
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="bg-accent text-paper sr-only rounded px-3 py-2 focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50">
      {t(locale, 'nav.skip')}
    </a>

    <header class="border-line border-b">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4 sm:px-6">
        <a href={localePath(locale)} class="font-display text-2xl font-semibold tracking-tight">
          {siteName}
        </a>
        <nav class="flex items-center gap-x-5 text-[0.95rem] sm:gap-x-7">
          {
            navigation.map(({ key, href, label }) => (
              <a
                href={localePath(locale, href)}
                aria-current={active === key ? 'page' : undefined}
                class:list={['hover:text-accent transition-colors', active === key ? 'text-accent font-semibold' : 'text-soft']}
              >
                {label}
              </a>
            ))
          }
          <span class="bg-line h-5 w-px" aria-hidden="true"></span>
          <div class="flex items-center gap-2 text-sm">
            {
              LOCALES.map((code) =>
                code === locale ? (
                  <span class="font-semibold" aria-current="true" title={LOCALE_NAMES[code]}>
                    {code.toUpperCase()}
                  </span>
                ) : (
                  <a
                    href={urls[code] ?? localePath(code)}
                    hreflang={LOCALE_TAGS[code]}
                    lang={LOCALE_TAGS[code]}
                    title={LOCALE_NAMES[code]}
                    class="text-soft hover:text-accent"
                  >
                    {code.toUpperCase()}
                  </a>
                )
              )
            }
          </div>
          <button type="button" data-theme-toggle class="text-soft hover:text-accent cursor-pointer" aria-label={t(locale, 'theme.toggle')} title={t(locale, 'theme.toggle')}>
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-line text-soft mt-20 border-t">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-8 text-sm sm:px-6">
        <p>{t(locale, 'site.tagline')}</p>
        <a href={localePath(locale, '/rss.xml')} class="hover:text-accent">{t(locale, 'footer.rss')}</a>
      </div>
    </footer>

    <script>
      document.addEventListener('astro:page-load', () => {
        const button = document.querySelector('[data-theme-toggle]') as HTMLElement | null;
        if (!button || button.dataset.ready) return;
        button.dataset.ready = 'true';
        button.addEventListener('click', () => {
          const dark = document.documentElement.classList.toggle('dark');
          try {
            localStorage.setItem('theme', dark ? 'dark' : 'light');
          } catch {
            // Private browsing: the choice just lasts for this page.
          }
        });
      });
    </script>
  </body>
</html>
