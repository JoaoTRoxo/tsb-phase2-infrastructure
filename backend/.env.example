# Copy to .env for local development. Generate the secrets with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
HOST=0.0.0.0
PORT=1337
APP_KEYS="change-me-1,change-me-2"
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# Leave empty for SQLite in .tmp/data.db. Use postgres in production.
DATABASE_CLIENT=sqlite

# Publishing rebuilds the site when both of these are set. The token needs
# "Contents: read and write" on the repository (a fine-grained personal token).
GITHUB_DISPATCH_REPO=
GITHUB_DISPATCH_TOKEN=
REBUILD_DEBOUNCE_SECONDS=60
