{
  "kind": "collectionType",
  "collectionName": "authors",
  "info": {
    "singularName": "author",
    "pluralName": "authors",
    "displayName": "Team member",
    "description": "A person on the blog team, shown on the team page."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "role": {
      "type": "string",
      "required": true
    },
    "rolePt": {
      "type": "string"
    },
    "bio": {
      "type": "text",
      "required": true,
      "maxLength": 500
    },
    "bioPt": {
      "type": "text",
      "maxLength": 500
    },
    "homeBase": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "default": 100
    }
  }
}
